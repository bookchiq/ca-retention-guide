# Copy to .env and fill in. .env is gitignored and must never be committed.

# CourtListener API token (free account): https://www.courtlistener.com/profile/api/
COURTLISTENER_TOKEN=

# Contact email sent in the User-Agent header to CourtListener. Kept out of git.
CL_CONTACT_EMAIL=

# Phase 2 only (optional)
ANTHROPIC_API_KEY=